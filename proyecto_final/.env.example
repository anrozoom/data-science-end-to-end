# Plantilla de variables del proyecto final. Copia:  cp .env.example .env   (y no subas .env).
# Escribe los valores sin comillas y sin el carácter "$". Esta lista crece en las fases siguientes.

# --- Interfaz de Kestra -------------------------------------------------------
# Contraseña de al menos 8 caracteres, con una mayúscula y un número.
KESTRA_ADMIN_USER=usuario@ejemplo.com
KESTRA_ADMIN_PASSWORD=CambiaEsto123
KESTRA_POSTGRES_PASSWORD=cambia_esto

# --- Snowflake (cuenta del proyecto final) -------------------------------------
# Identificador ORGNAME-ACCOUNTNAME (resultado de la consulta snowflake_account de snowflake/01_setup.sql).
SNOWFLAKE_ACCOUNT=MIORG-MICUENTA
SNOWFLAKE_USER=CENTINELA_SVC
SNOWFLAKE_ROLE=CENTINELA_ROLE
SNOWFLAKE_WAREHOUSE=CENTINELA_WH
SNOWFLAKE_DATABASE=CENTINELA
# Ruta de la llave privada DENTRO de los contenedores (proyecto_final/secrets/ se monta en /secrets).
SNOWFLAKE_PRIVATE_KEY_PATH=/secrets/snowflake_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=cambia_esto

# --- Kaggle ---------------------------------------------------------------------
KAGGLE_API_TOKEN=KGAT_valor_ficticio

# --- MLflow ---------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://127.0.0.1:5055

# --- API -------------------------------------------------------------------------
# Token para los endpoints protegidos /respaldo (interruptor) y /recargar (cabecera X-Token).
# Genera uno al azar:  openssl rand -hex 24
ADMIN_TOKEN=token_ficticio
