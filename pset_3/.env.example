# Plantilla de variables del PSet 3. Copia:  cp .env.example .env   (y no subas .env).
# Escribe los valores sin comillas.

# Servidor de MLflow del PSet 3 (docker-compose.yml de esta carpeta), NO el del
# devcontainer (5050). Los notebooks fijan este URI explícitamente.
MLFLOW_TRACKING_URI=http://127.0.0.1:5055

# Archivo .env con las credenciales SNOWFLAKE_* (par de llaves) para recrear el snapshot.
# Por defecto se usa el del PSet 2. Ruta relativa a pset_3/.
SNOWFLAKE_ENV_FILE=../pset_2/.env

# Clave gratuita de Google AI Studio (https://aistudio.google.com/apikey) para la
# prueba del LLM por prompting en 03_baseline_candidatos.ipynb.
GEMINI_API_KEY=clave_ficticia
GEMINI_MODEL=gemini-2.5-flash
