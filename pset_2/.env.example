# Plantilla de variables de entorno del PSet 2.
# Copia este archivo:  cp .env.example .env   y reemplaza cada valor ficticio.
# .env NO se sube a git (ver pset_2/.gitignore). Este archivo solo tiene nombres.
# Escribe cada valor sin comillas y sin el carácter "$".

# --- Interfaz de Kestra (etapa 1) ---------------------------------------------
# Kestra exige una contraseña de al menos 8 caracteres, con una mayúscula y un número.
KESTRA_ADMIN_USER=usuario@ejemplo.com
KESTRA_ADMIN_PASSWORD=CambiaEsto123
# Contraseña del Postgres interno de Kestra (solo la usan esos dos contenedores).
KESTRA_POSTGRES_PASSWORD=cambia_esto

# --- Snowflake (etapa 2) ------------------------------------------------------
# Identificador de la cuenta, con formato ORGNAME-ACCOUNTNAME.
SNOWFLAKE_ACCOUNT=MIORG-MICUENTA
SNOWFLAKE_USER=CENTINELA_SVC
SNOWFLAKE_ROLE=CENTINELA_ROLE
SNOWFLAKE_WAREHOUSE=CENTINELA_WH
SNOWFLAKE_DATABASE=CENTINELA
# Ruta de la llave privada DENTRO de los contenedores (pset_2/secrets/ se monta en /secrets).
SNOWFLAKE_PRIVATE_KEY_PATH=/secrets/snowflake_key.p8
# Contraseña de la llave privada, si la generaste cifrada (recomendado).
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=cambia_esto

# --- Kaggle (etapa 3) ---------------------------------------------------------
# Token del formato nuevo (empieza con KGAT_). Se crea en kaggle.com > Settings > API.
KAGGLE_API_TOKEN=KGAT_valor_ficticio
